        "\n",
        "\n",
        "INPUT_WINDOW = 24\n",
        "OUTPUT_WINDOW = 24\n",
        "\n",
        "def create_many_to_many_sequences(X, y, input_window, output_window):\n",
        "\n",
        "    X_sequences = []\n",
        "    y_sequences = []\n",
        "\n",
        "    for i in range(\n",
        "        input_window,\n",
        "        len(X) - output_window + 1\n",
        "    ):\n",
        "\n",
        "\n",
        "        X_sequences.append(\n",
        "            X[i-input_window:i]\n",
        "        )\n",
        "\n",
        "\n",
        "        y_sequences.append(\n",
        "            y[i:i+output_window]\n",
        "        )\n",
        "\n",
        "    return np.array(X_sequences), np.array(y_sequences)\n",
