        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from tensorflow.keras.models import Sequential\n",
        "from tensorflow.keras.layers import LSTM, RepeatVector, TimeDistributed, Dense\n",
        "\n",
        "\n",
        "X_train_auto = feature_scaler.transform(\n",
        "    train_df[features]\n",
        ")\n",
        "\n",
        "X_test_auto = feature_scaler.transform(\n",
        "    test_df[features]\n",
        ")\n",
        "\n",
        "WINDOW_SIZE = 24\n",
        "\n",
        "def create_autoencoder_sequences(X, window_size):\n",
        "\n",
        "    sequences = []\n",
        "\n",
        "    for i in range(\n",
        "        window_size,\n",
        "        len(X) + 1\n",
        "    ):\n",
        "        sequences.append(\n",
        "            X[i-window_size:i]\n",
        "        )\n",
        "\n",
        "    return np.array(sequences)\n",
        "\n",
        "\n",
        "X_train_auto = create_autoencoder_sequences(\n",
        "    X_train_auto,\n",
        "    WINDOW_SIZE\n",
        ")\n",
        "\n",
        "X_test_auto = create_autoencoder_sequences(\n",
        "    X_test_auto,\n",
        "    WINDOW_SIZE\n",
        ")\n",
        "\n",
        "print(\"X_train shape:\", X_train_auto.shape)\n",
        "print(\"X_test shape :\", X_test_auto.shape)\n",
        "\n",
        "\n",
        "lstm_autoencoder = Sequential([\n",
        "\n",
        "\n",
        "    LSTM(\n",
        "        64,\n",
        "        input_shape=(\n",
        "            X_train_auto.shape[1],\n",
        "            X_train_auto.shape[2]\n",
        "        )\n",
        "    ),\n",
        "\n",
        "\n",
        "    RepeatVector(WINDOW_SIZE),\n",
        "\n",
        "\n",
        "    LSTM(\n",
        "        64,\n",
        "        return_sequences=True\n",
        "    ),\n",
        "\n",
        "    TimeDistributed(\n",
        "        Dense(X_train_auto.shape[2])\n",
        "    )\n",
        "])\n",
        "\n",
        "lstm_autoencoder.compile(\n",
        "    optimizer='adam',\n",
        "    loss='mse',\n",
        "    metrics=['mae']\n",
        ")\n",
        "\n",
        "lstm_autoencoder.summary()\n",
        "\n",
        "history_autoencoder = lstm_autoencoder.fit(\n",
        "    X_train_auto,\n",
        "    X_train_auto,\n",
        "    epochs=20,\n",
        "    batch_size=32,\n",
