        "    ),\n",
        "    Dense(1)\n",
        "])\n",
        "\n",
        "# Compile\n",
        "multivariate_lstm.compile(\n",
        "    optimizer='adam',\n",
        "    loss='mse',\n",
        "    metrics=['mae']\n",
        ")\n",
        "\n",
        "# Model summary\n",
        "multivariate_lstm.summary()\n",
        "\n",
        "# Train\n",
        "history_multivariate = multivariate_lstm.fit(\n",
        "    X_train,\n",
        "    y_train,\n",
        "    epochs=20,\n",
        "    batch_size=32,\n",
        "    validation_split=0.1,\n",
